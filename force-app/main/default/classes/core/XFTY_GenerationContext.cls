/**
 * The state that every step of a single generation run needs to see: which
 * Provider Lookup to resolve variants through, whether (and when) to insert, how
 * far to follow relationships, and - during the context-aware value pass - the
 * record currently being built and the graph generated so far.
 *
 * Before this class the first three values were passed as separate arguments
 * through the whole factory call tree and the
 * `XFTY_DummySobjectProviderIntf.createBundle` contract. Bundling them:
 *
 * - shortens every signature in the engine;
 * - gives one place to apply the recursion transforms (`RELATED_ONLY` becomes
 *   `NOW` for related records, `PREVENT_CASCADE` becomes `NONE` one level down) -
 *   see {@link #forRelated};
 * - carries the `includeOptional(...)` paths down the graph;
 * - is what a context-aware expression reads (see
 *   {@link XFTY_ContextAwareExpressionIntf}, docs/roadmap/context-aware-values.md).
 *
 * `recordBeingBuilt` / `bundleSoFar` / `rowIndex` are populated only for the
 * per-record value pass (via {@link #forRecord}); everywhere else they are
 * null / -1.
 *
 * Immutable. Derive a new one with {@link #forRelated} / {@link #forRecord} /
 * {@link #forValueField} rather than mutating.
 */
@IsTest
public class XFTY_GenerationContext {
    public final XFTY_DummySObjectProviderLookupIntf providerLookup;
    public final XFTY_InsertModeEnum insertMode;
    public final XFTY_InsertInclusivityEnum inclusivity;

    /** The record whose value is being generated - only set during the context-aware pass. */
    public final SObject recordBeingBuilt;
    /**
     * The bundle this `createBundle` call has produced so far - `recordBeingBuilt`'s
     * generated relationships (`getList(relationshipField)`) *and* the sibling
     * primary records (`getList(<primaryTargetField>)`). Scoped to the current
     * call: records generated by a parent call (this record's own descendants, or
     * anything above it) are not in here yet.
     */
    public final XFTY_DummySObjectBundle bundleSoFar;
    /** Which row of a multi-record generation `recordBeingBuilt` is - the index into every list in `bundleSoFar`. */
    public final Integer rowIndex;

    /**
     * The single value field whose context-aware expression is running, and which
     * sibling context-aware values are still ungenerated - see
     * {@link XFTY_ValueFieldPass} and {@link #siblingValue}. Set only during the
     * context-aware value pass, one field at a time (via {@link #forValueField});
     * `null` everywhere else.
     */
    public final XFTY_ValueFieldPass valueFieldPass;

    /**
     * `includeOptional(...)` paths still to apply, each `[relationshipField,
     * ...deeper fields]`. A path whose head matches a relationship on the master
     * template being generated forces that relationship; {@link #forRelated} drops
     * the head and carries the tail into the child.
     */
    public final List<List<SObjectField>> forcedRelationshipPaths;

    /**
     * `put(List<SObjectField> path, value)` overrides still to apply. A path value
     * whose only remaining element is the target field (`isAtTarget()`) lands on
     * the master template being generated now; {@link #forRelated} drops the head
     * and carries the rest into the child, exactly like `forcedRelationshipPaths`.
     * The relationship walk itself is forced by adding each path's prefix to
     * `forcedRelationshipPaths`.
     */
    public final List<XFTY_PathValue> pathValues;

    /**
     * True on a structural (`NEVER`-like) build whose records get inserted later,
     * depth-batched - by `.depthBatched()` or the `DEFERRED` mode. Carried down
     * every derived context so `wireSharedAncestor` can reject it.
     */
    public final Boolean batchedInsertPending;

    /**
     * The Provider keys currently being generated up the ancestor chain, so
     * `XFTY_AncestorGenerator` can refuse to recurse into one already in progress
     * - see {@link XFTY_AncestorCycleGuard}. Configured by
     * {@link #withAncestorCycleGuard} and grown one level at a time by
     * {@link #enteringProviderFor}.
     */
    public final XFTY_AncestorCycleGuard cycleGuard;

    public XFTY_GenerationContext(
            XFTY_DummySObjectProviderLookupIntf providerLookup,
            XFTY_InsertModeEnum insertMode,
            XFTY_InsertInclusivityEnum inclusivity
    ) {
        this(
                providerLookup, insertMode, inclusivity, null, null, -1,
                new List<List<SObjectField>>(), new List<XFTY_PathValue>(), false, null,
                new XFTY_AncestorCycleGuard(false)
        );
    }

    private XFTY_GenerationContext(
            XFTY_DummySObjectProviderLookupIntf providerLookup,
            XFTY_InsertModeEnum insertMode,
            XFTY_InsertInclusivityEnum inclusivity,
            SObject recordBeingBuilt,
            XFTY_DummySObjectBundle bundleSoFar,
            Integer rowIndex,
            List<List<SObjectField>> forcedRelationshipPaths,
            List<XFTY_PathValue> pathValues,
            Boolean batchedInsertPending,
            XFTY_ValueFieldPass valueFieldPass,
            XFTY_AncestorCycleGuard cycleGuard
    ) {
        if (providerLookup == null) {
            throw new XFTY_DummySObjectFtyProviderException('A generation context requires a Provider Lookup.');
        }
        this.providerLookup = providerLookup;
        this.insertMode = (insertMode == null) ? XFTY_InsertModeEnum.NEVER : insertMode;
        this.inclusivity = (inclusivity == null) ? XFTY_InsertInclusivityEnum.NONE : inclusivity;
        this.recordBeingBuilt = recordBeingBuilt;
        this.bundleSoFar = bundleSoFar;
        this.rowIndex = rowIndex;
        this.forcedRelationshipPaths = (forcedRelationshipPaths == null)
                ? new List<List<SObjectField>>()
                : forcedRelationshipPaths;
        this.pathValues = (pathValues == null) ? new List<XFTY_PathValue>() : pathValues;
        this.batchedInsertPending = (batchedInsertPending == true);
        this.valueFieldPass = valueFieldPass;
        this.cycleGuard = cycleGuard;
    }

    /** A copy carrying the given `includeOptional(...)` paths (top-level entry point). */
    public XFTY_GenerationContext withForcedRelationshipPaths(List<List<SObjectField>> paths) {
        return new XFTY_GenerationContext(
                this.providerLookup, this.insertMode, this.inclusivity,
                this.recordBeingBuilt, this.bundleSoFar, this.rowIndex, paths, this.pathValues,
                this.batchedInsertPending, this.valueFieldPass, this.cycleGuard
        );
    }

    /**
     * A copy with a different inclusivity - used to generate an explicitly forced
     * ancestor (`includeOptional` / `put(path, ...)`) fully formed even when the
     * surrounding call asked for `NONE`.
     */
    public XFTY_GenerationContext withInclusivity(XFTY_InsertInclusivityEnum newInclusivity) {
        return new XFTY_GenerationContext(
                this.providerLookup, this.insertMode, newInclusivity,
                this.recordBeingBuilt, this.bundleSoFar, this.rowIndex, this.forcedRelationshipPaths, this.pathValues,
                this.batchedInsertPending, this.valueFieldPass, this.cycleGuard
        );
    }

    /**
     * A copy carrying the given `put(List<SObjectField>, value)` overrides, and
     * their relationship prefixes folded into the forced-relationship paths so the
     * ancestors on the way are generated (top-level entry point).
     */
    public XFTY_GenerationContext withPathValues(List<XFTY_PathValue> pathValues) {
        List<List<SObjectField>> forced = new List<List<SObjectField>>(this.forcedRelationshipPaths);
        for (XFTY_PathValue pathValue : pathValues) {
            forced.add(pathValue.relationshipPrefix());
        }
        return new XFTY_GenerationContext(
                this.providerLookup, this.insertMode, this.inclusivity,
                this.recordBeingBuilt, this.bundleSoFar, this.rowIndex, forced, pathValues,
                this.batchedInsertPending, this.valueFieldPass, this.cycleGuard
        );
    }

    /**
     * A copy whose cycle guard permits repeated Provider keys only if
     * `cyclesAllowed` - `.allowAncestorCycles()` on the Provider. The chain of
     * in-progress keys starts empty, so one level of self-reference (a record
     * with a parent of its own type, which terminates on its own) is always fine;
     * the guard fires on the *second* repeat. Top-level entry point.
     */
    public XFTY_GenerationContext withAncestorCycleGuard(Boolean cyclesAllowed) {
        return new XFTY_GenerationContext(
                this.providerLookup, this.insertMode, this.inclusivity,
                this.recordBeingBuilt, this.bundleSoFar, this.rowIndex, this.forcedRelationshipPaths,
                this.pathValues, this.batchedInsertPending, this.valueFieldPass, new XFTY_AncestorCycleGuard(cyclesAllowed)
        );
    }

    /** A copy whose cycle guard has descended one level into `providerKeyHash`. */
    public XFTY_GenerationContext enteringProviderFor(String providerKeyHash) {
        return new XFTY_GenerationContext(
                this.providerLookup, this.insertMode, this.inclusivity,
                this.recordBeingBuilt, this.bundleSoFar, this.rowIndex, this.forcedRelationshipPaths,
                this.pathValues, this.batchedInsertPending, this.valueFieldPass, this.cycleGuard.descendingInto(providerKeyHash)
        );
    }

    /** A copy marked as a structural build whose records get inserted later, depth-batched. */
    public XFTY_GenerationContext forBatchedInsert() {
        return new XFTY_GenerationContext(
                this.providerLookup, this.insertMode, this.inclusivity,
                this.recordBeingBuilt, this.bundleSoFar, this.rowIndex, this.forcedRelationshipPaths, this.pathValues, true,
                this.valueFieldPass, this.cycleGuard
        );
    }

    /**
     * The context for generating one level of related (ancestor) records:
     *
     * - `RELATED_ONLY` becomes `NOW` - the parents of a not-inserted primary
     *   record are still inserted;
     * - `PREVENT_CASCADE` becomes `NONE` - the direct relationships are generated
     *   but they do not generate their own.
     *
     * Every other mode / inclusivity is carried through unchanged; the per-record
     * fields are cleared. Forced-relationship paths do not propagate through this
     * overload - use {@link #forRelated(SObjectField)} from the recursion.
     */
    public XFTY_GenerationContext forRelated() {
        return this.forRelated(null);
    }

    /**
     * As {@link #forRelated()}, but for the child on `relationshipField`: only the
     * forced-relationship paths that start with `relationshipField` are carried
     * into it, with their head dropped.
     */
    public XFTY_GenerationContext forRelated(SObjectField relationshipField) {
        List<List<SObjectField>> childPaths = new List<List<SObjectField>>();
        for (List<SObjectField> path : this.forcedRelationshipPaths) {
            if (relationshipField != null && path.size() > 1 && path[0] == relationshipField) {
                List<SObjectField> tail = new List<SObjectField>();
                for (Integer i = 1; i < path.size(); i++) {
                    tail.add(path[i]);
                }
                childPaths.add(tail);
            }
        }
        List<XFTY_PathValue> childPathValues = new List<XFTY_PathValue>();
        for (XFTY_PathValue pathValue : this.pathValues) {
            if (relationshipField != null && !pathValue.isAtTarget() && pathValue.head() == relationshipField) {
                childPathValues.add(pathValue.tail());
            }
        }
        return new XFTY_GenerationContext(
                this.providerLookup,
                XFTY_InsertModeEnum.RELATED_ONLY == this.insertMode
                        ? XFTY_InsertModeEnum.NOW
                        : this.insertMode,
                XFTY_InsertInclusivityEnum.PREVENT_CASCADE == this.inclusivity
                        ? XFTY_InsertInclusivityEnum.NONE
                        : this.inclusivity,
                null, null, -1, childPaths, childPathValues, this.batchedInsertPending, null, this.cycleGuard
        );
    }

    /**
     * The context for evaluating a context-aware value on `record` (row
     * `rowIndex` of the generation), with `bundleSoFar` holding everything this
     * call has generated. Mode / lookup / inclusivity are unchanged.
     */
    public XFTY_GenerationContext forRecord(SObject record, XFTY_DummySObjectBundle bundleSoFar, Integer rowIndex) {
        return new XFTY_GenerationContext(
                this.providerLookup, this.insertMode, this.inclusivity,
                record, bundleSoFar, rowIndex, this.forcedRelationshipPaths, this.pathValues, this.batchedInsertPending, null,
                this.cycleGuard
        );
    }

    /**
     * As {@link #forRecord}, narrowed to the one context-aware value field being
     * generated now. `pendingContextAwareValues` is the set of context-aware
     * fields on this record whose expressions have not run yet.
     */
    public XFTY_GenerationContext forValueField(SObjectField fieldBeingBuilt, Set<SObjectField> pendingContextAwareValues) {
        return new XFTY_GenerationContext(
                this.providerLookup, this.insertMode, this.inclusivity,
                this.recordBeingBuilt, this.bundleSoFar, this.rowIndex,
                this.forcedRelationshipPaths, this.pathValues, this.batchedInsertPending,
                new XFTY_ValueFieldPass(fieldBeingBuilt, pendingContextAwareValues), this.cycleGuard
        );
    }

    /**
     * The final value of a sibling field on {@link #recordBeingBuilt}, for a
     * context-aware expression (see {@link XFTY_CopyFromSiblingExpression}). A returned `null`
     * means the sibling was genuinely generated to `null`.
     *
     * Throws when `siblingField` is itself a context-aware value that has not been
     * generated yet - the one case where `put(...)` order matters - so the mistake
     * surfaces loudly instead of as a silent wrong `null`.
     */
    public Object siblingValue(SObjectField siblingField) {
        if (this.valueFieldPass == null) {
            throw new XFTY_DummySObjectFtyProviderException(
                    'siblingValue(' + siblingField + ') can only be read while a context-aware value is being generated.'
            );
        }
        if (this.valueFieldPass.pendingContextAwareValues.contains(siblingField)) {
            throw new XFTY_DummySObjectFtyProviderException(
                    'The context-aware value for ' + this.valueFieldPass.fieldBeingBuilt
                            + ' reads sibling field ' + siblingField
                            + ', which is itself a context-aware value that has not been generated yet.'
                            + ' Context-aware values are generated in the order they are put, so'
                            + ' .put(' + siblingField + ', ...) must come before .put('
                            + this.valueFieldPass.fieldBeingBuilt + ', ...).'
            );
        }
        return this.recordBeingBuilt.get(siblingField);
    }
}
