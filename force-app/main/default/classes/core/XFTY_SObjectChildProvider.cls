/**
 * Configures one **child collection** hung off an `XFTY_DummySObjectProvider` -
 * the downward mirror of the framework's usual upward generation. The child
 * SObjectType is taken from the relationship field, so there is no type argument
 * to keep in sync:
 *
 * ```apex
 * new XFTY_DummySObjectProvider(Account.SObjectType, lookup)
 *     .setInsertMode(XFTY_InsertModeEnum.NOW)
 *     .with(new XFTY_SObjectChildProvider(Contact.AccountId, new Contact(Title = 'Buyer')).setQuantity(3))
 *     .with(new XFTY_SObjectChildProvider(Case.AccountId).setQuantity(2))
 *     .supplyBundle();
 * // bundle.getChildList(Contact.AccountId) -> 3 Contacts, bundle.getChildList(Case.AccountId) -> 2 Cases
 * ```
 *
 * Everything a child needs beyond the back-reference is configured here with the
 * same vocabulary as the main Provider: `put`, `putRequired`, `putOptional`,
 * `setInclusivity`, `setInsertMode`, `withVariant`. A child is generated by its
 * own Provider from the lookup, so its Master Template applies in full.
 */
@IsTest
public class XFTY_SObjectChildProvider {

    public final SObjectField relationshipField;
    public final SObjectType childType;
    private final SObject template;
    private Integer quantity = 1;
    private XFTY_InsertModeEnum insertModeOverride;
    private XFTY_InsertInclusivityEnum inclusivityOverride;
    private XFTY_LookupKeyIntf variantKey;
    private final List<PendingPut> pendingPuts = new List<PendingPut>();
    private final List<XFTY_SObjectChildProvider> grandchildProviders = new List<XFTY_SObjectChildProvider>();

    public XFTY_SObjectChildProvider(SObjectField relationshipField) {
        this(relationshipField, null);
    }

    public XFTY_SObjectChildProvider(SObjectField relationshipField, SObject template) {
        if (relationshipField == null) {
            throw new SanityException('XFTY_SObjectChildProvider needs the child relationship field.');
        }
        this.relationshipField = relationshipField;
        this.childType = relationshipField.getDescribe().getSObjectType();
        if (template != null && template.getSObjectType() != this.childType) {
            throw new SanityException(
                    'Template is a ' + template.getSObjectType() + ' but ' + relationshipField
                            + ' is on ' + this.childType + '.'
            );
        }
        this.template = (template == null) ? this.childType.newSObject() : template;
    }

    // Fluent config -----------------------------------------------------------------------

    /** Children generated per primary. Default 1. */
    public XFTY_SObjectChildProvider setQuantity(Integer quantity) {
        if (quantity == null || quantity < 1) {
            throw new SanityException('setQuantity(' + quantity + '): at least 1.');
        }
        this.quantity = quantity;
        return this;
    }

    public XFTY_SObjectChildProvider put(SObjectField field, XFTY_ValueExpressionIntf valueExpression) {
        PendingPut pendingPut = new PendingPut(field);
        pendingPut.valueExpression = valueExpression;
        this.pendingPuts.add(pendingPut);
        return this;
    }

    public XFTY_SObjectChildProvider put(SObjectField field, XFTY_ContextAwareExpressionIntf contextAwareExpression) {
        PendingPut pendingPut = new PendingPut(field);
        pendingPut.contextAwareExpression = contextAwareExpression;
        this.pendingPuts.add(pendingPut);
        return this;
    }

    public XFTY_SObjectChildProvider put(SObjectField field, Object literal) {
        PendingPut pendingPut = new PendingPut(field);
        pendingPut.literal = literal;
        pendingPut.isLiteral = true;
        this.pendingPuts.add(pendingPut);
        return this;
    }

    public XFTY_SObjectChildProvider putRequired(SObjectField field, XFTY_DummyDefaultRelationshipIntf relationship) {
        PendingPut pendingPut = new PendingPut(field);
        pendingPut.requiredRelationship = relationship;
        this.pendingPuts.add(pendingPut);
        return this;
    }

    public XFTY_SObjectChildProvider putOptional(SObjectField field, XFTY_DummyDefaultRelationshipIntf relationship) {
        PendingPut pendingPut = new PendingPut(field);
        pendingPut.optionalRelationship = relationship;
        this.pendingPuts.add(pendingPut);
        return this;
    }

    /** Insert mode for the children. Default: the parent Provider's. Cannot mix mock Ids with real DML. */
    public XFTY_SObjectChildProvider setInsertMode(XFTY_InsertModeEnum insertMode) {
        this.insertModeOverride = insertMode;
        return this;
    }

    /** Inclusivity for the children's *own* other relationships. Default: the parent Provider's. */
    public XFTY_SObjectChildProvider setInclusivity(XFTY_InsertInclusivityEnum inclusivity) {
        this.inclusivityOverride = inclusivity;
        return this;
    }

    /** Pin the child Provider variant (otherwise derived from the template's record type). */
    public XFTY_SObjectChildProvider withVariant(XFTY_LookupKeyIntf variantKey) {
        this.variantKey = variantKey;
        return this;
    }

    /**
     * Nest a further child collection under these children - grandchildren, and so
     * on. The nested relationship field must point at *this* child's SObjectType.
     *
     * ```apex
     * new XFTY_SObjectChildProvider(Contact.AccountId).setQuantity(3)
     *     .with(new XFTY_SObjectChildProvider(Case.ContactId).setQuantity(2))
     * // per Account: 3 Contacts, 6 Cases
     * ```
     *
     * The row count multiplies down the tree; a governor-budget warning fires if
     * generation gets expensive.
     */
    public XFTY_SObjectChildProvider with(XFTY_SObjectChildProvider grandchildProvider) {
        if (grandchildProvider == null) {
            throw new SanityException('with(...) needs an XFTY_SObjectChildProvider.');
        }
        assertFieldPointsAt(grandchildProvider.relationshipField, this.childType);
        this.grandchildProviders.add(grandchildProvider);
        return this;
    }

    /** A relationship field used to hang a child collection must actually point at the parent type. */
    public static void assertFieldPointsAt(SObjectField relationshipField, SObjectType parentType) {
        List<SObjectType> referenceTo = relationshipField.getDescribe().getReferenceTo();
        if (!referenceTo.contains(parentType)) {
            throw new SanityException(
                    relationshipField + ' points at ' + referenceTo + ' but it is being hung off a '
                            + parentType + ' collection.'
            );
        }
    }

    // Used by XFTY_DummySObjectProvider ---------------------------------------------------

    public Integer getQuantity() {
        return this.quantity;
    }

    public XFTY_InsertModeEnum effectiveInsertMode(XFTY_InsertModeEnum parentMode) {
        XFTY_InsertModeEnum mode = (this.insertModeOverride == null) ? parentMode : this.insertModeOverride;
        assertModesCompatible(parentMode, mode);
        return mode;
    }

    public XFTY_InsertInclusivityEnum effectiveInclusivity(XFTY_InsertInclusivityEnum parentInclusivity) {
        return (this.inclusivityOverride == null) ? parentInclusivity : this.inclusivityOverride;
    }

    /** Build the `quantity` child templates for one primary, back-reference set (or left null in a deferred build). */
    public List<SObject> templatesForParent(Id parentId) {
        List<SObject> templates = new List<SObject>();
        for (Integer i = 0; i < this.quantity; i++) {
            SObject childTemplate = this.template.clone(false, true, false, false);
            childTemplate.put(this.relationshipField, parentId);
            templates.add(childTemplate);
        }
        return templates;
    }

    /** A fresh Provider for these children, with this child provider's puts / variant / nested children applied. */
    public XFTY_DummySObjectProvider newProvider(XFTY_DummySObjectProviderLookupIntf lookup) {
        XFTY_DummySObjectProvider provider = (this.variantKey == null)
                ? new XFTY_DummySObjectProvider(this.childType, lookup)
                : new XFTY_DummySObjectProvider(this.variantKey, lookup);
        for (PendingPut pendingPut : this.pendingPuts) {
            pendingPut.applyTo(provider);
        }
        for (XFTY_SObjectChildProvider grandchildProvider : this.grandchildProviders) {
            provider.with(grandchildProvider);
        }
        return provider;
    }

    private static void assertModesCompatible(XFTY_InsertModeEnum parentMode, XFTY_InsertModeEnum childMode) {
        Boolean mixesMockWithReal =
                (parentMode == XFTY_InsertModeEnum.MOCK && childMode == XFTY_InsertModeEnum.NOW)
                        || (parentMode == XFTY_InsertModeEnum.NOW && childMode == XFTY_InsertModeEnum.MOCK);
        if (mixesMockWithReal) {
            throw new SanityException(
                    'A child collection cannot mix mock Ids with real DML - parent is '
                            + parentMode + ', child is ' + childMode + '.'
            );
        }
    }

    // ---------------------------------------------------------------------------

    private class PendingPut {
        final SObjectField field;
        XFTY_ValueExpressionIntf valueExpression;
        XFTY_ContextAwareExpressionIntf contextAwareExpression;
        XFTY_DummyDefaultRelationshipIntf requiredRelationship;
        XFTY_DummyDefaultRelationshipIntf optionalRelationship;
        Object literal;
        Boolean isLiteral = false;

        PendingPut(SObjectField field) {
            this.field = field;
        }

        void applyTo(XFTY_DummySObjectProvider provider) {
            if (this.valueExpression != null) {
                provider.put(this.field, this.valueExpression);
            } else if (this.contextAwareExpression != null) {
                provider.put(this.field, this.contextAwareExpression);
            } else if (this.requiredRelationship != null) {
                provider.putRequired(this.field, this.requiredRelationship);
            } else if (this.optionalRelationship != null) {
                provider.putOptional(this.field, this.optionalRelationship);
            } else if (this.isLiteral) {
                provider.put(this.field, this.literal);
            }
        }
    }

    public class SanityException extends Exception {
    }
}
